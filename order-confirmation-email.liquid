<!--
  NUTRAESSENCE — ORDER CONFIRMATION EMAIL
  Built to the finalized layout: Header → Tracker hero → Order number →
  Order details → Customer details → Contact block.

  WHERE TO PASTE THIS:
  Shopify Admin → Settings → Notifications → "Order confirmation"
  → paste this whole file into the template body.

  SUBJECT LINE (goes in the separate "Email subject" field, not this body):
    Order {{ order_name }} is confirmed

  PREVIEW TEXT: set via the hidden preheader div right below <body> —
  edit the sentence in there directly.

  CDN ASSETS — search for "PASTE-" to find every placeholder that needs
  a real hosted URL before this goes live:
    - PASTE-LOGO-CDN-URL-HERE      → NutraEssence logo (header)
    - PASTE-EMAIL-ICON-CDN-URL-HERE → small envelope icon (contact row)
    - PASTE-MAIL-ICON-CDN-URL-HERE  → circular mail icon ("Any questions?" box)
-->
{% assign order_date = 'now' | date: "%b %-d" %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order {{ order_name }} is confirmed</title>
<style>
  body, table, td { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table { border-collapse: collapse; }
  img { border: 0; display: block; }

  body {
    margin: 0;
    padding: 0;
    background: #F3EFE8;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    color: #3D3D3D;
  }

  a { color: #CC4B18; text-decoration: none; }

  .wrapper { width: 100%; background: #F3EFE8; padding: 32px 16px; }
  .container { max-width: 560px; margin: 0 auto; }

  /* ── Block 1: Header ── */
  .header-cell { text-align: center; padding-bottom: 20px; }
  .header-cell img { margin: 0 auto 16px; }
  .header-title { margin: 0; font-size: 22px; font-weight: 700; color: #1A1A1A; }

  /* ── Block 1: Hero (tracker) ── */
  .hero-box {
    background: #FBF4EA;
    border-radius: 14px;
    padding: 28px 20px 24px;
    margin-bottom: 16px;
  }
  .tracker-node {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    text-align: center;
    vertical-align: middle;
    font-size: 13px;
    line-height: 30px;
  }
  .tracker-node--done { background: #CC4B18; color: #ffffff; font-weight: 700; }
  .tracker-node--pending { background: #ffffff; border: 2px solid #E2E0DC; }
  .tracker-line { height: 2px; background: #E2E0DC; font-size: 0; line-height: 0; }
  .tracker-caption {
    padding-top: 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  .tracker-caption--muted { color: #9a9a9a; }
  .tracker-date { display: block; font-size: 11px; font-weight: 400; letter-spacing: 0; color: #9a9a9a; padding-top: 2px; }

  .step-labels { width: 100%; margin-top: 20px; border: 1px solid #E2E0DC; border-radius: 8px; background: #ffffff; }
  .step-labels td {
    text-align: center;
    padding: 10px 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #9a9a9a;
    border-right: 1px solid #E2E0DC;
  }
  .step-labels td:last-child { border-right: none; }
  .step-labels td.step-labels--active { color: #CC4B18; }

  .hero-copy { padding: 20px 4px 0; text-align: center; font-size: 14px; line-height: 1.6; color: #3D3D3D; }

  .cta-cell { padding: 20px 0 4px; text-align: center; }
  .cta-button {
    display: inline-block;
    background: #CC4B18;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 13px 32px;
    border-radius: 999px;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* ── Block 2: Order number strip ── */
  .order-strip {
    border: 1px solid #E2E0DC;
    border-radius: 10px;
    background: #ffffff;
    padding: 14px 18px;
    margin-bottom: 16px;
    font-size: 14px;
    color: #1A1A1A;
  }
  .order-strip strong { font-weight: 700; }

  /* ── Block 3: Order details ── */
  .section-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a9a9a;
    padding: 4px 2px 10px;
  }

  .details-card {
    border: 1px solid #E2E0DC;
    border-radius: 10px;
    background: #ffffff;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .item-row td { padding: 16px 18px; border-bottom: 1px solid #E2E0DC; vertical-align: top; }
  .item-image {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    border: 1px solid #E2E0DC;
    object-fit: cover;
  }
  .item-title { font-size: 14px; font-weight: 600; color: #1A1A1A; }
  .item-variant { font-size: 12px; color: #6B6B6B; padding-top: 2px; }
  .item-qty { font-size: 12px; color: #6B6B6B; padding-top: 4px; }
  .item-price { font-size: 14px; font-weight: 600; color: #1A1A1A; text-align: right; white-space: nowrap; }

  .totals { padding: 16px 18px 20px; }
  .totals-row td { padding: 4px 0; font-size: 13px; color: #6B6B6B; }
  .totals-row .totals-value { text-align: right; color: #1A1A1A; }
  .totals-discount { color: #CC4B18; }
  .totals-row--total td { padding-top: 12px; font-size: 15px; font-weight: 700; color: #1A1A1A; border-top: 1px solid #E2E0DC; }

  /* ── Block 4: Customer details ── */
  .customer-card {
    border: 1px solid #E2E0DC;
    border-radius: 10px;
    background: #ffffff;
    margin-bottom: 16px;
  }
  .customer-cell {
    width: 50%;
    padding: 16px 18px;
    vertical-align: top;
    border-bottom: 1px solid #E2E0DC;
  }
  .customer-cell + .customer-cell { border-left: 1px solid #E2E0DC; }
  .customer-heading {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a9a9a;
    padding-bottom: 6px;
  }
  .customer-body { font-size: 13px; line-height: 1.6; color: #1A1A1A; }

  /* ── Block 4: Contact ── */
  .contact-row {
    border: 1px solid #E2E0DC;
    border-radius: 10px;
    background: #ffffff;
    padding: 14px 18px;
    margin-bottom: 16px;
    font-size: 13px;
    line-height: 1.6;
    color: #3D3D3D;
  }
  .contact-row img { width: 20px; height: 20px; }

  .questions-box {
    background: #FFEFEA;
    border-radius: 10px;
    padding: 18px 20px;
  }
  .questions-icon img { width: 40px; height: 40px; border-radius: 50%; }
  .questions-heading { font-size: 15px; font-weight: 700; color: #1A1A1A; padding-bottom: 4px; }
  .questions-body { font-size: 13px; line-height: 1.6; color: #6B6B6B; }
  .questions-body a { color: #CC4B18; font-weight: 600; }

  .footer { padding: 24px 8px 0; text-align: center; }
  .footer-text { font-size: 11px; line-height: 1.7; color: #9a9a9a; }

  @media (max-width: 480px) {
    .wrapper { padding: 20px 12px; }
    .customer-cell { display: block; width: 100%; border-left: none !important; }
    .customer-cell + .customer-cell { border-top: 1px solid #E2E0DC; }
  }
</style>
</head>
<body>

  <!-- Preview text / preheader (hidden, edit the sentence below) -->
  <div style="display:none; max-height:0; overflow:hidden; font-size:1px; line-height:1px; color:#F3EFE8; opacity:0;">
    Your order {{ order_name }} is confirmed — here's what's next.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="wrapper">
    <tr>
      <td>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="container">

          <!-- ═══════════ Block 1: Header ═══════════ -->
          <tr>
            <td class="header-cell">
              <!-- TODO: replace with your CDN logo URL -->
              <img src="PASTE-LOGO-CDN-URL-HERE" alt="{{ shop.name }}" width="150">
              <p class="header-title">Thank You For Your Order</p>
            </td>
          </tr>

          <!-- ═══════════ Block 1: Hero (tracker) ═══════════ -->
          <tr>
            <td>
              <div class="hero-box">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td width="30" class="tracker-node tracker-node--done">&#10003;</td>
                    <td class="tracker-line"></td>
                    <td width="30" class="tracker-node tracker-node--pending"></td>
                    <td class="tracker-line"></td>
                    <td width="30" class="tracker-node tracker-node--pending"></td>
                  </tr>
                  <tr>
                    <td style="text-align:left;">
                      <div class="tracker-caption">Order Placed<span class="tracker-date">{{ order_date }}</span></div>
                    </td>
                    <td></td>
                    <td style="text-align:center;">
                      <div class="tracker-caption tracker-caption--muted">Shipping</div>
                    </td>
                    <td></td>
                    <td style="text-align:right;">
                      <div class="tracker-caption tracker-caption--muted">Delivery</div>
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="step-labels">
                  <tr>
                    <td class="step-labels--active">Order Placed</td>
                    <td>Shipping</td>
                    <td>Delivery</td>
                  </tr>
                </table>

                <p class="hero-copy">
                  Hello {{ customer.first_name }}, we've received your order and it's now being prepared.
                  We'll send a confirmation with tracking as soon as it's on the way.
                </p>

                {% if order_status_url %}
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                      <td class="cta-cell">
                        <a href="{{ order_status_url }}" class="cta-button">View Your Order</a>
                      </td>
                    </tr>
                  </table>
                {% endif %}
              </div>
            </td>
          </tr>

          <!-- ═══════════ Block 2: Order number ═══════════ -->
          <tr>
            <td>
              <div class="order-strip">
                Order: <strong>{{ order_name }}</strong>{% if po_number %} &nbsp;·&nbsp; PO #{{ po_number }}{% endif %}
              </div>
            </td>
          </tr>

          <!-- ═══════════ Block 3: Order details ═══════════ -->
          <tr>
            <td>
              <div class="section-heading">Order Details</div>
              <div class="details-card">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  {% for line in line_items %}
                    <tr class="item-row">
                      <td width="56">
                        {% if line.image %}
                          <img src="{{ line.image | img_url: '112x112' }}" alt="{{ line.title | escape }}" class="item-image">
                        {% else %}
                          <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" alt="" class="item-image">
                        {% endif %}
                      </td>
                      <td style="padding-left: 0;">
                        <div class="item-title">{{ line.title }}</div>
                        {% if line.variant.title != 'Default Title' %}
                          <div class="item-variant">{{ line.variant.title }}</div>
                        {% endif %}
                        <div class="item-qty">Qty: {{ line.quantity }}</div>
                      </td>
                      <td class="item-price">
                        {% if line.final_line_price > 0 %}
                          {{ line.final_line_price | money }}
                        {% else %}
                          Free
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </table>

                <div class="totals">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                    <tr class="totals-row">
                      <td>Subtotal</td>
                      <td class="totals-value">{{ subtotal_price | money }}</td>
                    </tr>
                    {% if total_discounts > 0 %}
                      <tr class="totals-row">
                        <td class="totals-discount">Order Discount</td>
                        <td class="totals-value totals-discount">&minus;{{ total_discounts | money }}</td>
                      </tr>
                    {% endif %}
                    {% if requires_shipping %}
                      <tr class="totals-row">
                        <td>Shipping</td>
                        <td class="totals-value">{% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}Free{% endif %}</td>
                      </tr>
                    {% endif %}
                    <tr class="totals-row">
                      <td>Taxes</td>
                      <td class="totals-value">{{ tax_price | money }}</td>
                    </tr>
                    <tr class="totals-row totals-row--total">
                      <td>Total</td>
                      <td class="totals-value">{{ total_price | money_with_currency }}</td>
                    </tr>
                  </table>
                </div>
              </div>
            </td>
          </tr>

          <!-- ═══════════ Block 4: Customer details ═══════════ -->
          <tr>
            <td>
              <div class="section-heading">Customer Details</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="customer-card">
                <tr>
                  <td class="customer-cell">
                    <div class="customer-heading">Shipping address</div>
                    <div class="customer-body">
                      {% if requires_shipping and shipping_address %}
                        {{ shipping_address | format_address }}
                      {% else %}
                        &mdash;
                      {% endif %}
                    </div>
                  </td>
                  <td class="customer-cell">
                    <div class="customer-heading">Billing address</div>
                    <div class="customer-body">
                      {% if billing_address %}
                        {{ billing_address | format_address }}
                      {% else %}
                        &mdash;
                      {% endif %}
                    </div>
                  </td>
                </tr>
                <tr>
                  <td class="customer-cell" style="border-bottom: none;">
                    <div class="customer-heading">Shipping method</div>
                    <div class="customer-body">
                      {% if requires_shipping and shipping_method %}
                        {{ shipping_method.title }}
                      {% else %}
                        &mdash;
                      {% endif %}
                    </div>
                  </td>
                  <td class="customer-cell" style="border-bottom: none;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ═══════════ Block 4: Contact ═══════════ -->
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="contact-row">
                <tr>
                  <td width="28">
                    <!-- TODO: replace with your CDN email icon URL -->
                    <img src="PASTE-EMAIL-ICON-CDN-URL-HERE" alt="" width="20" height="20">
                  </td>
                  <td>
                    If you have any questions, reply to this email or contact us at
                    <a href="mailto:support@mynutraessence.com">support@mynutraessence.com</a>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="questions-box">
                <tr>
                  <td width="52" class="questions-icon" style="vertical-align: top;">
                    <!-- TODO: replace with your CDN mail icon URL -->
                    <img src="PASTE-MAIL-ICON-CDN-URL-HERE" alt="" width="40" height="40">
                  </td>
                  <td style="vertical-align: top; padding-left: 4px;">
                    <div class="questions-heading">Any questions?</div>
                    <div class="questions-body">
                      If you need any help whatsoever or just want to chat, email us anytime
                      <a href="mailto:sureorder@gmail.com">sureorder@gmail.com</a>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ═══════════ Footer ═══════════ -->
          <tr>
            <td class="footer">
              <p class="footer-text">{{ shop.name }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>

{%- if billing_address.country_code == 'DE' or billing_address.country_code == 'DK' -%}
  {%- if shop.terms_of_service.body != blank -%}
    {{ shop.terms_of_service | attach_as_pdf: "Terms of service" }}
  {%- endif -%}
  {%- if shop.refund_policy.body != blank -%}
    {{ shop.refund_policy | attach_as_pdf: "Refund policy" }}
  {%- endif -%}
{%- endif -%}
