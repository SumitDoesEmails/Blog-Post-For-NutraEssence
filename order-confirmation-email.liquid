
{% assign order_date = 'now' | date: "%b %-d" %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order {{ order_name }} is confirmed</title>
<style>
  body, table, td { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table { border-collapse: collapse; }
  img { border: 0; display: block; }

  body {
    margin: 0;
    padding: 0;
    background: #F3EFE8;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    color: #3D3D3D;
  }

  a { color: #CC4B18; text-decoration: none; }

  .wrapper { width: 100%; background: #F3EFE8; padding: 32px 16px; }
  .container { max-width: 560px; margin: 0 auto; }

  /* ── Block 1: Header ── */
  .header-cell { text-align: center; padding-bottom: 20px; }
  .header-cell img { margin: 0 auto 16px; }
  .header-title { margin: 0; font-size: 22px; font-weight: 700; color: #1A1A1A; }

  /* ── Block 1: Hero (tracker) ── */
  .hero-box {
    background: #FBF4EA;
    border-radius: 14px;
    padding: 28px 20px 24px;
    margin-bottom: 16px;
  }
  .tracker-caption {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  .tracker-caption--muted { color: #212121; }
  .tracker-date { display: inline-block; font-size: 11px; font-weight: 400; letter-spacing: 0; color: #212121; padding-left: 8px; text-transform: none; }

  .hero-copy { padding: 22px 4px 0; text-align: center; font-size: 14px; line-height: 1.6; color: #3D3D3D; }
  .hero-note { padding: 10px 4px 0; text-align: center; font-size: 13px; line-height: 1.6; color: #6B6B6B; }
  .hero-note strong { color: #1A1A1A; }

  .pending-payment-table { margin-top: 12px; }
  .pending-payment-table td {
    padding: 6px 10px;
    font-size: 12px;
    color: #1A1A1A;
  }
  .pending-payment-table tr:first-child td {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #212121;
  }

  .note-box {
    background: #F7F6F3;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 12.5px;
    line-height: 1.6;
    color: #6B6B6B;
    margin-top: 16px;
  }
  .note-box strong { color: #1A1A1A; }

  .cta-cell { padding: 20px 0 4px; text-align: center; }
  .cta-button {
    display: inline-block;
    background: #CC4B18;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 13px 32px;
    border-radius: 999px;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* ── Block 2: Order number strip ── */
  .order-strip {
    border: 0px solid #FFFFFF;
    border-radius: 10px;
    background: #ffffff;
    padding: 14px 18px;
    margin-bottom: 16px;
    font-size: 14px;
    color: #1A1A1A;
  }
  .order-strip strong { font-weight: 700; }

  /* ── Block 3: Order details ── */
  .section-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #212121;
    padding: 4px 2px 10px;
  }

  .details-card {
    border: 1px solid #E2E0DC;
    border-radius: 10px;
    background: #ffffff;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .item-row td { padding: 16px 18px; border-bottom: 1px solid #E2E0DC; vertical-align: top; }
  .item-image {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    border: 1px solid #E2E0DC;
    object-fit: cover;
  }
  .item-title { font-size: 14px; font-weight: 600; color: #1A1A1A; }
  .item-variant { font-size: 12px; color: #6B6B6B; padding-top: 2px; }
  .item-qty { font-size: 12px; color: #6B6B6B; padding-top: 4px; }
  .item-price { font-size: 14px; font-weight: 600; color: #1A1A1A; text-align: right; white-space: nowrap; }

  .totals { padding: 16px 18px 20px; }
  .totals-row td { padding: 4px 0; font-size: 13px; color: #6B6B6B; }
  .totals-row .totals-value { text-align: right; color: #1A1A1A; }
  .totals-discount { color: #CC4B18; }
  .totals-row--total td { padding-top: 12px; font-size: 15px; font-weight: 700; color: #1A1A1A; border-top: 1px solid #E2E0DC; }

  /* ── Block 4: Customer details ── */
  .customer-card {
    border: 1px solid #E2E0DC;
    border-radius: 10px;
    background: #ffffff;
    margin-bottom: 16px;
  }
  .customer-cell {
    width: 50%;
    padding: 16px 18px;
    vertical-align: top;
    border-bottom: 1px solid #E2E0DC;
  }
  .customer-cell + .customer-cell { border-left: 1px solid #E2E0DC; }
  .customer-heading {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #212121;
    padding-bottom: 6px;
  }
  .customer-body { font-size: 13px; line-height: 1.6; color: #1A1A1A; }

  /* ── Block 4: Contact ── */
  .questions-box {
    background: #FFEFEA;
    border-radius: 10px;
    padding: 18px 20px;
  }
  .questions-icon img { width: 40px; height: 40px; border-radius: 50%; }
  .questions-heading { font-size: 15px; font-weight: 700; color: #1A1A1A; padding-bottom: 4px; }
  .questions-body { font-size: 13px; line-height: 1.6; color: #6B6B6B; }
  .questions-body a { color: #CC4B18; font-weight: 600; }

  .footer { padding: 24px 8px 0; text-align: center; }
  .footer-text { font-size: 11px; line-height: 1.7; color: #212121; }

  @media (max-width: 480px) {
    .wrapper { padding: 20px 12px; }
    .customer-cell { display: block; width: 100%; border-left: none !important; }
    .customer-cell + .customer-cell { border-top: 1px solid #E2E0DC; }
  }
</style>
</head>
<body>

  <!-- Preview text / preheader (hidden, edit the sentence below) -->
  <div style="display:none; max-height:0; overflow:hidden; font-size:1px; line-height:1px; color:#F3EFE8; opacity:0;">
    Your order {{ order_name }} is confirmed — here's what's next.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="wrapper">
    <tr>
      <td>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="container">

          <!-- ═══════════ Block 1: Header ═══════════ -->
          <tr>
            <td class="header-cell">
              <!-- TODO: replace with your CDN logo URL -->
              <img src="https://cdn.shopify.com/s/files/1/0761/2776/4736/files/Flows_Image_6.png?v=1786957059" alt="{{ shop.name }}" width="150">
              <p class="header-title">Thank You For Your Order</p>
            </td>
          </tr>

          <!-- ═══════════ Block 1: Hero (tracker) ═══════════ -->
          <tr>
            <td>
              <div class="hero-box">
                <!--
                  Order-confirmation trackers only ever show one real state
                  (placed) — the other two nodes are just visual "more to
                  come" markers, not live tracking, so they carry no label
                  or date. Each dot/line segment below is its own tiny
                  fixed-height nested table (not a plain <td> with CSS
                  height) because most email clients ignore CSS height on
                  bare table cells and will stretch it to match the row —
                  that's what produced the grey block instead of a thin line.
                -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="30" valign="middle" style="border:0;">
                      <table role="presentation" width="30" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td width="30" height="30" align="center" valign="middle" style="width:30px; height:30px; border-radius:50%; background:#CC4B18; color:#ffffff; font-size:13px; font-weight:700; line-height:30px; border:0;">&#10003;</td>
                      </tr></table>
                    </td>
                    <td valign="middle" style="border:0;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td height="2" style="font-size:2px; line-height:2px; background:#CC4B18; border:0;">&nbsp;</td>
                      </tr></table>
                    </td>
                    <td width="30" valign="middle" style="border:0;">
                      <table role="presentation" width="30" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td width="30" height="30" align="center" valign="middle" style="width:30px; height:30px; border-radius:50%; background:#ffffff; border:0px solid #E2E0DC;">&nbsp;</td>
                      </tr></table>
                    </td>
                    <td valign="middle" style="border:0;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td height="2" style="font-size:2px; line-height:2px; background:#CC4B18; border:0;">&nbsp;</td>
                      </tr></table>
                    </td>
                    <td width="30" valign="middle" style="border:0;">
                      <table role="presentation" width="30" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td width="30" height="30" align="center" valign="middle" style="width:30px; height:30px; border-radius:50%; background:#ffffff; border:0px solid #E2E0DC;">&nbsp;</td>
                      </tr></table>
                    </td>
                  </tr>
                </table>

                <!--
                  Captions live in their own table, not sharing columns
                  with the dots above — the dots table pins column widths
                  to 30px, so "Order Placed" wrapped into two lines when it
                  was forced into that narrow a column. This table has no
                  fixed widths, so each caption gets as much room as it needs.
                -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="34%" style="padding-top: 10px; text-align: left;">
                      <span class="tracker-caption">Order Placed<span class="tracker-date">{{ order_date }}</span></span>
                    </td>
                    <td width="32%" style="padding-top: 10px; text-align: center;">
                      <span class="tracker-caption tracker-caption--muted">Shipping</span>
                    </td>
                    <td width="34%" style="padding-top: 10px; text-align: right;">
                      <span class="tracker-caption tracker-caption--muted">Delivery</span>
                    </td>
                  </tr>
                </table>

                {% capture hero_copy %}
                  {% if has_pending_payment %}
                    {% if buyer_action_required %}
                      Hello {{ customer.first_name }}, you'll get a confirmation email as soon as your payment is complete.
                    {% else %}
                      Hello {{ customer.first_name }}, your payment is being processed. We'll email you once your order is confirmed.
                    {% endif %}
                  {% else %}
                    {% if requires_shipping %}
                      {% case delivery_method %}
                        {% when 'pick-up' %}
                          Hello {{ customer.first_name }}, we've received your order and it's being prepared for pickup. We'll email you when it's ready.
                        {% when 'local' %}
                          Hello {{ customer.first_name }}, we're getting your order ready for delivery.
                        {% else %}
                          Hello {{ customer.first_name }}, we've received your order and it's now being prepared. We'll send a confirmation with tracking as soon as it's on the way.
                      {% endcase %}
                    {% else %}
                      Hello {{ customer.first_name }}, we've received your order and it's being prepared.
                    {% endif %}
                  {% endif %}
                {% endcapture %}
                <p class="hero-copy">{{ hero_copy | strip_newlines | strip }}</p>

                {% if delivery_instructions != blank %}
                  <p class="hero-note"><strong>Delivery notes:</strong> {{ delivery_instructions }}</p>
                {% endif %}

                {% if consolidated_estimated_delivery_time %}
                  <p class="hero-note">Estimated delivery: <strong>{{ consolidated_estimated_delivery_time }}</strong></p>
                {% endif %}

                {% assign transaction_count = transactions | size %}
                {% if transaction_count > 0 %}
                  {% for transaction in transactions %}
                    {% if transaction.show_buyer_pending_payment_instructions? %}
                      <p class="hero-note">{{ transaction.buyer_pending_payment_notice }}</p>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="pending-payment-table">
                        <tr>
                          {% for instruction in transaction.buyer_pending_payment_instructions %}
                            <td>{{ instruction.header }}</td>
                          {% endfor %}
                          <td>Amount</td>
                        </tr>
                        <tr>
                          {% for instruction in transaction.buyer_pending_payment_instructions %}
                            <td>{{ instruction.value }}</td>
                          {% endfor %}
                          <td>{{ transaction.amount | money }}</td>
                        </tr>
                      </table>
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% if order_status_url %}
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                      <td class="cta-cell">
                        <a href="{{ order_status_url }}" class="cta-button">View Your Order</a>
                      </td>
                    </tr>
                  </table>
                {% endif %}
              </div>
            </td>
          </tr>

          <!-- ═══════════ Block 2: Order number ═══════════ -->
          <tr>
            <td>
              <div class="order-strip">
                Order: <strong>{{ order_name }}</strong>{% if po_number %} &nbsp;·&nbsp; PO #{{ po_number }}{% endif %}
              </div>
            </td>
          </tr>

          <!-- ═══════════ Block 3: Order details ═══════════ -->
          <tr>
            <td>
              <div class="section-heading">Order Details</div>
              <div class="details-card">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  {% for line in line_items %}
                    <tr class="item-row">
                      <td width="56">
                        {% if line.image %}
                          <img src="{{ line.image | img_url: '112x112' }}" alt="{{ line.title | escape }}" class="item-image">
                        {% else %}
                          <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" alt="" class="item-image">
                        {% endif %}
                      </td>
                      <td style="padding-left: 0;">
                        <div class="item-title">{{ line.title }}</div>
                        {% if line.variant.title != 'Default Title' %}
                          <div class="item-variant">{{ line.variant.title }}</div>
                        {% endif %}
                        <div class="item-qty">Qty: {{ line.quantity }}</div>
                      </td>
                      <td class="item-price">
                        {% if line.final_line_price > 0 %}
                          {{ line.final_line_price | money }}
                        {% else %}
                          Free
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </table>

                <div class="totals">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                    <tr class="totals-row">
                      <td>Subtotal</td>
                      <td class="totals-value">{{ subtotal_price | money }}</td>
                    </tr>
                    {% if total_discounts > 0 %}
                      <tr class="totals-row">
                        <td class="totals-discount">Order Discount</td>
                        <td class="totals-value totals-discount">&minus;{{ total_discounts | money }}</td>
                      </tr>
                    {% endif %}
                    {% if requires_shipping %}
                      <tr class="totals-row">
                        <td>Shipping</td>
                        <td class="totals-value">{% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}Free{% endif %}</td>
                      </tr>
                    {% endif %}
                    {% if total_duties %}
                      <tr class="totals-row">
                        <td>Duties</td>
                        <td class="totals-value">{{ total_duties | money }}</td>
                      </tr>
                    {% endif %}
                    <tr class="totals-row">
                      <td>Taxes</td>
                      <td class="totals-value">{{ tax_price | money }}</td>
                    </tr>
                    {% if total_tip and total_tip > 0 %}
                      <tr class="totals-row">
                        <td>Tip</td>
                        <td class="totals-value">{{ total_tip | money }}</td>
                      </tr>
                    {% endif %}
                    <tr class="totals-row totals-row--total">
                      <td>Total</td>
                      <td class="totals-value">{{ total_price | money_with_currency }}</td>
                    </tr>
                  </table>
                </div>
              </div>

              {% assign gift_card_line_items = line_items | where: "gift_card" %}
              {% if gift_card_line_items.first %}
                {% assign found_gift_card_with_recipient_email = false %}
                {% for line_item in gift_card_line_items %}
                  {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
                    {% assign found_gift_card_with_recipient_email = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                <div class="note-box">
                  {% if found_gift_card_with_recipient_email %}
                    Your gift card recipient will receive a separate email with their gift card code.
                  {% else %}
                    You'll receive a separate email for any gift cards in this order.
                  {% endif %}
                </div>
              {% endif %}
            </td>
          </tr>

          <!-- ═══════════ Block 4: Customer details ═══════════ -->
          <tr>
            <td>
              <div class="section-heading">Customer Details</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="customer-card">
                <tr>
                  <td class="customer-cell">
                    <div class="customer-heading">Shipping address</div>
                    <div class="customer-body">
                      {% if requires_shipping and shipping_address %}
                        {{ shipping_address | format_address }}
                      {% else %}
                        &mdash;
                      {% endif %}
                    </div>
                  </td>
                  <td class="customer-cell">
                    <div class="customer-heading">Billing address</div>
                    <div class="customer-body">
                      {% if billing_address %}
                        {{ billing_address | format_address }}
                      {% else %}
                        &mdash;
                      {% endif %}
                    </div>
                  </td>
                </tr>
                <tr>
                  <td class="customer-cell" style="border-bottom: none;">
                    <div class="customer-heading">Shipping method</div>
                    <div class="customer-body">
                      {% if requires_shipping and shipping_method %}
                        {{ shipping_method.title }}
                      {% else %}
                        &mdash;
                      {% endif %}
                    </div>
                  </td>
                  <td class="customer-cell" style="border-bottom: none;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ═══════════ Block 4: Contact ═══════════ -->
          <tr>
            <td>
              <!--
                NOTE: only one support address is used below
                (support@mynutraessence.com) — the previous draft had the
                link text and the mailto: destination pointing at two
                different addresses (support@mynutraessence.com displayed,
                sureorder@gmail.com linked), which is a broken/misleading
                link. Swap CONTACT_EMAIL below if that's not the right
                inbox — just make sure the visible text and href always
                match.
              -->
              {% assign contact_email = "support@mynutraessence.com" %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="questions-box">
                <tr>
                  <td width="52" class="questions-icon" style="vertical-align: top;">
                    <!-- TODO: replace with your CDN mail icon URL -->
                    <img src="https://cdn.shopify.com/s/files/1/0761/2776/4736/files/NicePng_email-icon-png-transparent_903587.png?v=1786957541" alt="" width="40" height="40">
                  </td>
                  <td style="vertical-align: top; padding-left: 4px;">
                    <div class="questions-heading">Any questions?</div>
                    <div class="questions-body">
                      If you need any help whatsoever or just want to chat, email us anytime at
                      <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ═══════════ Footer ═══════════ -->
          <tr>
            <td class="footer">
              <p class="footer-text">{{ shop.name }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>

{%- if billing_address.country_code == 'DE' or billing_address.country_code == 'DK' -%}
  {%- if shop.terms_of_service.body != blank -%}
    {{ shop.terms_of_service | attach_as_pdf: "Terms of service" }}
  {%- endif -%}
  {%- if shop.refund_policy.body != blank -%}
    {{ shop.refund_policy | attach_as_pdf: "Refund policy" }}
  {%- endif -%}
{%- endif -%}
