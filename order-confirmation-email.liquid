<!--
  NUTRAESSENCE — ORDER CONFIRMATION EMAIL
  Paste this whole file into Shopify Admin → Settings → Notifications →
  "Order confirmation" (replaces the default template body). Liquid tags
  are the standard Shopify order-status notification variables, so this
  renders live order data — it is not a static mockup.

  Design: minimal, single card, three-step order tracker (à la Sundays),
  one product list, a clean subtotal block, and shipping/payment info.
  Deliberately does not attempt to handle every possible cart shape
  (bundles, split deliveries, nested subscriptions) — it covers the
  standard single-shipment order, which is the overwhelming majority of
  sends. If NutraEssence starts selling bundles/multi-shipment products,
  extend the line-item loop then.
-->
{% capture email_title %}
  {% if has_pending_payment %}
    Thank you for your order!
  {% else %}
    Thank you for your order!
  {% endif %}
{% endcapture %}

{% capture email_subtitle %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      You'll get a confirmation email after completing your payment.
    {% else %}
      Your payment is being processed. We'll email you once it's confirmed.
    {% endif %}
  {% else %}
    {% if requires_shipping %}
      {% case delivery_method %}
        {% when 'pick-up' %}
          We're getting your order ready for pickup.
        {% when 'local' %}
          Hi {{ customer.first_name }}, we're getting your order ready for delivery.
        {% else %}
          We're getting your order ready to ship. We'll email you the moment it's on its way.
      {% endcase %}
    {% else %}
      Your order is confirmed and being prepared.
    {% endif %}
  {% endif %}
{% endcapture %}

{% assign order_date = 'now' | date: "%b %-d" %}
{% assign gift_card_line_items = line_items | where: "gift_card" %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ email_title | strip }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

  body, table, td { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table { border-collapse: collapse; }
  img { border: 0; display: block; }

  body {
    margin: 0;
    padding: 0;
    background: #F3EFE8;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #3D3D3D;
  }

  a { color: #CC4B18; text-decoration: none; }

  .wrapper { width: 100%; background: #F3EFE8; padding: 32px 16px; }
  .container { max-width: 560px; margin: 0 auto; }

  /* ── Wordmark ── */
  .logo-cell { text-align: center; padding-bottom: 28px; }
  .logo-text {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.32em;
    color: #1A1A1A;
    text-transform: uppercase;
  }

  /* ── Headline ── */
  .headline-cell { text-align: center; padding: 0 8px 28px; }
  .headline {
    margin: 0 0 8px;
    font-size: 26px;
    line-height: 1.3;
    font-weight: 700;
    color: #1A1A1A;
  }
  .subhead {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #6B6B6B;
  }

  /* ── Tracker ── */
  .tracker-wrap { padding: 4px 6px 32px; }
  .tracker-node {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    text-align: center;
    vertical-align: middle;
    font-size: 13px;
    line-height: 30px;
  }
  .tracker-node--done {
    background: #CC4B18;
    color: #ffffff;
    font-weight: 700;
  }
  .tracker-node--pending {
    background: #ffffff;
    border: 2px solid #E2E0DC;
  }
  .tracker-line { height: 2px; background: #E2E0DC; font-size: 0; line-height: 0; }
  .tracker-label {
    padding-top: 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  .tracker-label--muted { color: #9a9a9a; }
  .tracker-date { display: block; font-size: 11px; font-weight: 400; letter-spacing: 0; color: #9a9a9a; padding-top: 2px; }

  /* ── Order meta row ── */
  .meta-row td { padding-bottom: 20px; font-size: 13px; }
  .order-number { color: #6B6B6B; }
  .order-number strong { color: #1A1A1A; }
  .view-order-link { text-align: right; font-weight: 600; text-decoration: underline; }

  /* ── Card ── */
  .card {
    background: #ffffff;
    border: 1px solid #E2E0DC;
    border-radius: 14px;
    overflow: hidden;
  }
  .card-inner { padding: 22px 22px 4px; }

  .item-row td { padding-bottom: 20px; vertical-align: top; }
  .item-image {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    border: 1px solid #E2E0DC;
    object-fit: cover;
  }
  .item-title { font-size: 14px; font-weight: 600; color: #1A1A1A; }
  .item-variant, .item-plan { font-size: 12px; color: #6B6B6B; padding-top: 2px; }
  .item-plan { color: #CC4B18; font-weight: 500; }
  .item-price { font-size: 14px; font-weight: 600; color: #1A1A1A; text-align: right; white-space: nowrap; }
  .item-price-original { font-size: 12px; color: #9a9a9a; text-decoration: line-through; display: block; font-weight: 400; }

  .divider { border-top: 1px solid #E2E0DC; margin: 0 22px; }

  .totals { padding: 18px 22px 22px; }
  .totals-row td { padding: 4px 0; font-size: 13px; color: #6B6B6B; }
  .totals-row .totals-value { text-align: right; color: #1A1A1A; }
  .totals-row--total td { padding-top: 12px; font-size: 15px; font-weight: 700; color: #1A1A1A; border-top: 1px solid #E2E0DC; }
  .totals-discount { color: #CC4B18; }

  /* ── CTA ── */
  .cta-cell { padding: 28px 0 4px; text-align: center; }
  .cta-button {
    display: inline-block;
    background: #CC4B18;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 600;
    padding: 13px 30px;
    border-radius: 999px;
    text-decoration: none;
  }
  .cta-secondary { display: block; padding-top: 14px; font-size: 12px; color: #6B6B6B; }
  .cta-secondary a { color: #6B6B6B; text-decoration: underline; }

  /* ── Info section ── */
  .info-section { padding: 36px 4px 0; }
  .info-heading {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a9a9a;
    padding-bottom: 6px;
  }
  .info-body { font-size: 13px; line-height: 1.6; color: #3D3D3D; }
  .info-col { width: 50%; vertical-align: top; padding-bottom: 24px; }

  /* ── Note box ── */
  .note-box {
    background: #F7F6F3;
    border-radius: 10px;
    padding: 16px 18px;
    font-size: 12.5px;
    line-height: 1.6;
    color: #6B6B6B;
    margin-top: 8px;
  }
  .note-box strong { color: #1A1A1A; }

  /* ── Footer ── */
  .footer { padding: 32px 8px 0; text-align: center; }
  .footer-text { font-size: 12px; line-height: 1.7; color: #9a9a9a; }
  .footer-text a { color: #6B6B6B; text-decoration: underline; }

  @media (max-width: 480px) {
    .wrapper { padding: 20px 12px; }
    .headline { font-size: 22px; }
    .info-col { display: block; width: 100%; padding-bottom: 20px; }
    .view-order-link { text-align: left; padding-top: 4px; }
  }
</style>
</head>
<body>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="wrapper">
    <tr>
      <td>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="container">

          <!-- Wordmark -->
          <tr>
            <td class="logo-cell">
              {% if shop.email_logo_url %}
                <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 140 }}" style="margin: 0 auto;">
              {% else %}
                <span class="logo-text">{{ shop.name }}</span>
              {% endif %}
            </td>
          </tr>

          <!-- Headline -->
          <tr>
            <td class="headline-cell">
              <p class="headline">{{ email_title | strip }}</p>
              <p class="subhead">{{ email_subtitle | strip }}</p>
            </td>
          </tr>

          <!-- Tracker -->
          {% unless has_pending_payment %}
          <tr>
            <td class="tracker-wrap">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="30" class="tracker-node tracker-node--done">&#10003;</td>
                  <td class="tracker-line"></td>
                  <td width="30" class="tracker-node tracker-node--pending"></td>
                  <td class="tracker-line"></td>
                  <td width="30" class="tracker-node tracker-node--pending"></td>
                </tr>
                <tr>
                  <td style="text-align:left;">
                    <div class="tracker-label">Placed<span class="tracker-date">{{ order_date }}</span></div>
                  </td>
                  <td></td>
                  <td style="text-align:center;">
                    <div class="tracker-label tracker-label--muted">Shipped</div>
                  </td>
                  <td></td>
                  <td style="text-align:right;">
                    <div class="tracker-label tracker-label--muted">Delivered</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endunless %}

          <!-- Order # / View order -->
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="meta-row">
                <tr>
                  <td class="order-number">Order <strong>{{ order_name }}</strong>{% if po_number %} &nbsp;·&nbsp; PO #{{ po_number }}{% endif %}</td>
                  {% if order_status_url %}
                    <td class="view-order-link"><a href="{{ order_status_url }}">View order</a></td>
                  {% endif %}
                </tr>
              </table>
            </td>
          </tr>

          <!-- Card: line items + totals -->
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="card">
                <tr>
                  <td>
                    <div class="card-inner">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                        {% for line in line_items %}
                          <tr class="item-row">
                            <td width="64">
                              {% if line.image %}
                                <img src="{{ line.image | img_url: '128x128' }}" alt="{{ line.title | escape }}" class="item-image">
                              {% else %}
                                <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" alt="" class="item-image">
                              {% endif %}
                            </td>
                            <td style="padding-left: 14px;">
                              <div class="item-title">{{ line.title }}&nbsp;&times;&nbsp;{{ line.quantity }}</div>
                              {% if line.variant.title != 'Default Title' %}
                                <div class="item-variant">{{ line.variant.title }}</div>
                              {% endif %}
                              {% if line.selling_plan_allocation %}
                                <div class="item-plan">{{ line.selling_plan_allocation.selling_plan.name }}</div>
                              {% endif %}
                              {% if line.refunded_quantity > 0 %}
                                <div class="item-variant">Refunded</div>
                              {% endif %}
                            </td>
                            <td class="item-price">
                              {% if line.original_line_price != line.final_line_price %}
                                <span class="item-price-original">{{ line.original_line_price | money }}</span>
                              {% endif %}
                              {% if line.final_line_price > 0 %}
                                {{ line.final_line_price | money }}
                              {% else %}
                                Free
                              {% endif %}
                            </td>
                          </tr>
                        {% endfor %}
                      </table>
                    </div>
                    <div class="divider"></div>
                    <div class="totals">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                        <tr class="totals-row">
                          <td>Subtotal</td>
                          <td class="totals-value">{{ subtotal_price | money }}</td>
                        </tr>
                        {% if total_discounts > 0 %}
                          <tr class="totals-row">
                            <td class="totals-discount">Discount</td>
                            <td class="totals-value totals-discount">&minus;{{ total_discounts | money }}</td>
                          </tr>
                        {% endif %}
                        {% if requires_shipping %}
                          <tr class="totals-row">
                            <td>{% if delivery_method == 'pick-up' %}Pickup{% else %}Shipping{% endif %}</td>
                            <td class="totals-value">{% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}Free{% endif %}</td>
                          </tr>
                        {% endif %}
                        {% if total_duties %}
                          <tr class="totals-row">
                            <td>Duties</td>
                            <td class="totals-value">{{ total_duties | money }}</td>
                          </tr>
                        {% endif %}
                        <tr class="totals-row">
                          <td>Taxes</td>
                          <td class="totals-value">{{ tax_price | money }}</td>
                        </tr>
                        {% if total_tip and total_tip > 0 %}
                          <tr class="totals-row">
                            <td>Tip</td>
                            <td class="totals-value">{{ total_tip | money }}</td>
                          </tr>
                        {% endif %}
                        <tr class="totals-row totals-row--total">
                          <td>Total</td>
                          <td class="totals-value">{{ total_price | money_with_currency }}</td>
                        </tr>
                      </table>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {% if gift_card_line_items.first %}
            <tr>
              <td style="padding-top: 16px;">
                <div class="note-box">
                  {% assign found_recipient_gift_card = false %}
                  {% for line_item in gift_card_line_items %}
                    {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
                      {% assign found_recipient_gift_card = true %}
                    {% endif %}
                  {% endfor %}
                  {% if found_recipient_gift_card %}
                    Your gift card recipient will receive a separate email with their gift card code.
                  {% else %}
                    You'll receive a separate email for any gift cards in this order.
                  {% endif %}
                </div>
              </td>
            </tr>
          {% endif %}

          {% if delivery_instructions != blank %}
            <tr>
              <td style="padding-top: 16px;">
                <div class="note-box"><strong>Delivery notes:</strong> {{ delivery_instructions }}</div>
              </td>
            </tr>
          {% endif %}

          {% if consolidated_estimated_delivery_time %}
            <tr>
              <td style="padding-top: 16px;">
                <div class="note-box"><strong>Estimated delivery:</strong> {{ consolidated_estimated_delivery_time }}</div>
              </td>
            </tr>
          {% endif %}

          <!-- CTA -->
          {% if order_status_url %}
            <tr>
              <td class="cta-cell">
                <a href="{{ order_status_url }}" class="cta-button">Track your order</a>
                {% if shop.url %}
                  <span class="cta-secondary">or <a href="{{ shop.url }}">keep browsing</a></span>
                {% endif %}
              </td>
            </tr>
          {% endif %}

          <!-- Shipping / payment info -->
          <tr>
            <td class="info-section">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  {% if requires_shipping and shipping_address %}
                    <td class="info-col">
                      <div class="info-heading">Shipping address</div>
                      <div class="info-body">{{ shipping_address | format_address }}</div>
                    </td>
                  {% endif %}
                  {% if billing_address %}
                    <td class="info-col">
                      <div class="info-heading">Billing address</div>
                      <div class="info-body">{{ billing_address | format_address }}</div>
                    </td>
                  {% endif %}
                </tr>
                <tr>
                  {% if requires_shipping and shipping_method %}
                    <td class="info-col">
                      <div class="info-heading">Shipping method</div>
                      <div class="info-body">{{ shipping_method.title }}</div>
                    </td>
                  {% endif %}
                  {% for transaction in transactions %}
                    {% if transaction.status == "success" and transaction.kind == "capture" or transaction.kind == "sale" %}
                      <td class="info-col">
                        <div class="info-heading">Payment</div>
                        <div class="info-body">
                          {% if transaction.payment_details.gift_card_last_four_digits %}
                            Gift card ending {{ transaction.payment_details.gift_card_last_four_digits }}
                          {% elsif transaction.payment_details.credit_card_company %}
                            {{ transaction.payment_details.credit_card_company }} ending {{ transaction.payment_details.credit_card_last_four_digits }}
                          {% else %}
                            {{ transaction.gateway_display_name }}
                          {% endif %}
                        </div>
                      </td>
                      {% break %}
                    {% endif %}
                  {% endfor %}
                </tr>
              </table>
            </td>
          </tr>

          <!-- Packaging note -->
          <tr>
            <td style="padding-top: 4px;">
              <div class="note-box">
                <strong>A small heads up:</strong> to cut down on packaging waste, we sometimes combine multi-quantity orders into one larger container instead of several small ones — you still get the exact quantity you ordered.
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="footer">
              <p class="footer-text">
                Questions? Reply to this email or reach us at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a><br>
                {{ shop.name }}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>

{%- if billing_address.country_code == 'DE' or billing_address.country_code == 'DK' -%}
  {%- if shop.terms_of_service.body != blank -%}
    {{ shop.terms_of_service | attach_as_pdf: "Terms of service" }}
  {%- endif -%}
  {%- if shop.refund_policy.body != blank -%}
    {{ shop.refund_policy | attach_as_pdf: "Refund policy" }}
  {%- endif -%}
{%- endif -%}
